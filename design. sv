module uart_tx(
  input logic clk, rst, tx_start,
  input logic [7:0] tx_data,
  output logic tx, tx_done
);
  typedef enum logic [1:0] {IDLE, START, DATA, STOP} state_t;
  state_t state = IDLE;
  logic [3:0] bit_cnt;
  logic [7:0] data_reg;
  logic [15:0] clk_cnt;

  always_ff @(posedge clk or posedge rst) begin
    if(rst) begin state<=IDLE; tx<=1; tx_done<=0; clk_cnt<=0; bit_cnt<=0; end
    else begin
      case(state)
        IDLE: begin tx<=1; tx_done<=0; if(tx_start) begin data_reg<=tx_data; state<=START; clk_cnt<=0; end end
        START: begin tx<=0; if(clk_cnt==15) begin clk_cnt<=0; state<=DATA; bit_cnt<=0; end else clk_cnt<=clk_cnt+1; end
        DATA: begin tx<=data_reg[bit_cnt]; if(clk_cnt==15) begin clk_cnt<=0; if(bit_cnt==7) state<=STOP; else bit_cnt<=bit_cnt+1; end else clk_cnt<=clk_cnt+1; end
        STOP: begin tx<=1; if(clk_cnt==15) begin clk_cnt<=0; state<=IDLE; tx_done<=1; end else clk_cnt<=clk_cnt+1; end
      endcase
    end
  end
endmodule

module uart_rx(
  input logic clk, rst, rx,
  output logic [7:0] rx_data,
  output logic rx_done
);
  typedef enum logic [1:0] {IDLE, START, DATA, STOP} state_t;
  state_t state = IDLE;
  logic [3:0] bit_cnt;
  logic [7:0] data_reg;
  logic [15:0] clk_cnt;

  always_ff @(posedge clk or posedge rst) begin
    if(rst) begin state<=IDLE; rx_done<=0; clk_cnt<=0; bit_cnt<=0; rx_data<=0; end
    else begin
      case(state)
        IDLE: begin rx_done<=0; if(rx==0) begin state<=START; clk_cnt<=0; end end
        START: begin if(clk_cnt==7) begin clk_cnt<=0; state<=DATA; bit_cnt<=0; end else clk_cnt<=clk_cnt+1; end
        DATA: begin if(clk_cnt==15) begin clk_cnt<=0; data_reg[bit_cnt]<=rx; if(bit_cnt==7) state<=STOP; else bit_cnt<=bit_cnt+1; end else clk_cnt<=clk_cnt+1; end
        STOP: begin if(clk_cnt==15) begin clk_cnt<=0; state<=IDLE; rx_data<=data_reg; rx_done<=1; end else clk_cnt<=clk_cnt+1; end
      endcase
    end
  end
endmodule
